{
  "entities": {
    "Report": {
      "title": "Saved Transformation Report",
      "description": "User transformation report data including photos and analysis",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "path": { "type": "string" },
        "userData": { "type": "object" },
        "report": { "type": "object" },
        "photos": { "type": "object" },
        "progressPhotos": { "type": "object" }
      },
      "required": ["id", "userId", "timestamp", "path", "userData", "report", "photos"]
    },
    "User": {
      "title": "User Profile",
      "description": "User account information and access status",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "email": { "type": "string" },
        "fullName": { "type": "string" },
        "displayName": { "type": "string" },
        "hasAccess": { "type": "boolean" },
        "isPremium": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "photoURL": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "level": { "type": "number" },
        "xp": { "type": "number" },
        "streak": { "type": "number" },
        "membershipTier": { "type": "string" },
        "plan": { "type": "string", "enum": ["free", "pro", "coach"] },
        "billingCycle": { "type": "string", "enum": ["monthly", "annual", "lifetime"] },
        "renewalDate": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "past_due", "canceled", "trialing"] },
        "clientBand": { "type": "string", "enum": ["1-5", "6-15", "16-30", "31+"] },
        "cancelAtPeriodEnd": { "type": "boolean" },
        "subscriptionId": { "type": "string" },
        "gymPin": { "type": "string" }
      },
      "required": ["userId", "email", "hasAccess"]
    },
    "DailyLog": {
      "title": "Daily Activity Log",
      "description": "Daily tracking for steps, water, meals, and habits",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "steps": { "type": "number" },
        "stepGoal": { "type": "number" },
        "water": { "type": "number" },
        "waterGoal": { "type": "number" },
        "meals": { "type": "array", "items": { "type": "object" } },
        "habits": { "type": "object" },
        "completedWorkouts": { "type": "number" }
      },
      "required": ["id", "date"]
    },
    "Measurement": {
      "title": "Body Measurement",
      "description": "Tracking body stats over time",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "weight": { "type": "number" },
        "bodyFat": { "type": "number" },
        "waist": { "type": "number" },
        "chest": { "type": "number" },
        "arms": { "type": "number" }
      },
      "required": ["id", "timestamp"]
    }
  },
  "firestore": {
    "/reports/{reportId}": {
      "schema": "Report",
      "description": "Collection of transformation reports"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles and access grants"
    },
    "/users/{userId}/dailyLogs/{date}": {
      "schema": "DailyLog",
      "description": "Daily activity tracking"
    },
    "/users/{userId}/measurements/{measurementId}": {
      "schema": "Measurement",
      "description": "Historical body measurements"
    }
  }
}
